---
import CircuitBackground from "./CircuitBackground.astro";

// Asymmetric hero: left column = emblem + wordmark + oscilloscope + tagline;
// right column = "Currently" pill rail + links. Circuit board is now the
// hero backdrop (not a corner watermark). Only motion signatures kept:
// oscilloscope + emblem proximity glitch.
---

<section class="hero">
  <CircuitBackground />

  <div class="hero-inner">
    <div class="left">
      <div class="lockup">
        <a href="#top" class="emblem" aria-label="Jordanaftermidnight" id="hero-emblem">
          <picture class="cyan">
            <source srcset="/brand/icon-emblem-cyan.webp" type="image/webp" />
            <img src="/brand/icon-emblem-cyan.png" alt="" width="104" height="104" />
          </picture>
          <picture class="gold">
            <source srcset="/brand/icon-emblem-gold.webp" type="image/webp" />
            <img src="/brand/icon-emblem-gold.png" alt="" width="104" height="104" />
          </picture>
        </a>
        <div class="mark">
          <h1 class="wordmark">jordanaftermidnight</h1>
          <canvas class="osc" id="hero-osc" width="660" height="24"></canvas>
        </div>
      </div>
      <p class="identity">
        Compliance expert by day. Hacker, designer, musician by night.<br />
        <span class="soft">Fluent in code. Not bound by it.</span>
      </p>
    </div>

    <aside class="right">
      <div class="currently">
        <span class="currently-label">&gt; Currently</span>
        <ul class="pills">
          <li><a class="pill" href="https://github.com/jordanaftermidnight/localmem" target="_blank" rel="noopener">localmem</a></li>
          <li><a class="pill" href="https://github.com/jordanaftermidnight/IRIS_project" target="_blank" rel="noopener">IRIS</a></li>
          <li><a class="pill" href="https://github.com/jordanaftermidnight/kyb-risk-tool" target="_blank" rel="noopener">KYB</a></li>
        </ul>
      </div>
      <ul class="links">
        <li><a href="https://github.com/jordanaftermidnight" target="_blank" rel="noopener">github ↗</a></li>
        <li><a href="mailto:contact@jordanaftermidnight.com">contact ↗</a></li>
      </ul>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    /* Contain the absolute-positioned CircuitBackground */
    isolation: isolate;
    /* Full-viewport-width band — the circuit board bleeds off both edges,
       not just the right, so the "extends beyond" illusion is symmetric. */
    padding-block: 48px;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    /* Content is centered + padded to match main's content area */
    max-width: 1080px;
    margin: 0 auto;
    padding-inline: 40px;
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 40px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .hero { padding-block: 36px; }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-inline: 20px;
    }
  }

  /* ─── left column ────────────────────────────────────────────────── */
  .left { display: flex; flex-direction: column; gap: 20px; }
  .lockup {
    display: flex;
    align-items: center;
    gap: 22px;
    min-width: 0; /* let the wordmark shrink instead of overflowing */
  }
  @media (max-width: 900px) {
    .lockup {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }
  .emblem {
    width: 104px; height: 104px;
    position: relative;
    display: inline-block;
    line-height: 0;
    flex-shrink: 0;
    /* The ONLY glow on the page — everything else gets border/color changes */
    filter: drop-shadow(0 0 18px color-mix(in oklab, var(--cyan) 30%, transparent));
  }
  .emblem picture,
  .emblem picture img {
    display: block;
    width: 100%; height: 100%;
    mix-blend-mode: screen;
    transition: opacity 400ms ease;
  }
  .emblem picture.gold {
    position: absolute; inset: 0;
    opacity: 0;
  }
  .emblem:hover picture.gold,
  .emblem.is-hot picture.gold { opacity: 1; }
  .emblem:hover picture.cyan,
  .emblem.is-hot picture.cyan { opacity: 0; }
  .emblem:hover,
  .emblem.is-hot {
    filter: drop-shadow(0 0 24px color-mix(in oklab, var(--gold-hot) 50%, transparent));
  }

  /* Digital-tear glitch — kept as the signature motion for the emblem */
  .emblem.is-hot { animation: emblem-glitch 450ms steps(6, end); }
  @keyframes emblem-glitch {
    0%   { transform: translate(0, 0) scale(1);
           filter: drop-shadow(0 0 18px rgba(0,212,255,0.5)); clip-path: none; }
    12%  { transform: translate(-6px, 3px) scale(1.03);
           filter: drop-shadow(6px 0 0 #ff2540) drop-shadow(-6px 0 0 #00e4ff) hue-rotate(90deg) contrast(1.4);
           clip-path: inset(0 0 62% 0); }
    22%  { transform: translate(7px, -2px) scale(0.97);
           filter: drop-shadow(-5px 0 0 #ff2540) drop-shadow(5px 0 0 #00e4ff) hue-rotate(-60deg);
           clip-path: inset(58% 0 0 0); }
    35%  { transform: translate(-3px, 2px) scale(1.02);
           filter: drop-shadow(3px 0 0 #ff2540) drop-shadow(-3px 0 0 #00e4ff) hue-rotate(150deg) blur(0.6px) brightness(1.4);
           clip-path: inset(28% 0 42% 0); }
    48%  { transform: translate(4px, 0) scale(1);
           filter: drop-shadow(-2px 0 0 #ff2540) drop-shadow(2px 0 0 #00e4ff); clip-path: none; }
    62%  { transform: translate(-1px, 1px); filter: hue-rotate(30deg) brightness(1.15); }
    100% { transform: translate(0, 0) scale(1);
           filter: drop-shadow(0 0 18px color-mix(in oklab, var(--gold-hot) 50%, transparent));
           clip-path: none; }
  }

  .mark { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .wordmark {
    font-family: var(--font-mono);
    font-weight: 700;
    /* Fluid: comfortably big on desktop, still readable on 320px viewports */
    font-size: clamp(24px, 4.5vw, 33px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--paper);
    word-break: break-word;
    /* No text-shadow — the emblem carries the glow, wordmark stays clean */
  }
  .osc {
    display: block;
    width: 100%;
    max-width: 420px;
    height: 26px;
  }

  .identity {
    font-family: var(--font-sans);
    /* Fluid so the first sentence stays on one line at any typical width */
    font-size: clamp(13px, 1.6vw, 15px);
    line-height: 1.6;
    color: var(--body);
    /* No max-width — let the sentence take its natural width */
  }
  .identity .soft {
    color: var(--muted);
    font-style: italic;
  }

  /* ─── right column ───────────────────────────────────────────────── */
  .right {
    display: flex; flex-direction: column;
    align-items: flex-end;
    gap: 20px;
    padding-top: 6px;
  }
  @media (max-width: 900px) {
    .right { align-items: flex-start; }
  }

  .currently {
    display: flex; flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  @media (max-width: 900px) {
    .currently { align-items: flex-start; }
  }
  .currently-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cyan);
    opacity: 0.75;
  }
  .pills {
    display: flex; flex-direction: column;
    gap: 8px; list-style: none;
    align-items: flex-end;
  }
  @media (max-width: 900px) {
    .pills { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
  }
  .pill {
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid var(--pill-line);
    border-radius: 3px;
    font-size: 12px;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--paper);
    background: rgba(18, 18, 31, 0.7);
    transition: border-color 220ms ease, color 220ms ease;
  }
  .pill:hover {
    border-color: var(--gold-hot);
    color: var(--gold-hot);
  }

  .links {
    display: flex; flex-direction: column;
    gap: 6px; list-style: none;
    align-items: flex-end;
  }
  @media (max-width: 900px) {
    .links { align-items: flex-start; flex-direction: row; gap: 16px; }
  }
  .links a {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dust);
    transition: color 220ms ease;
  }
  .links a:hover { color: var(--gold-hot); }
</style>

<script>
  // ── oscilloscope band, tapered edges, mouse-x frequency ──
  (function osc() {
    const c = document.getElementById("hero-osc") as HTMLCanvasElement | null;
    if (!c) return;
    const ctx = c.getContext("2d");
    if (!ctx) return;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    function fit() {
      if (!c || !ctx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const box = c.getBoundingClientRect();
      c.width = box.width * dpr;
      c.height = box.height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    fit();
    window.addEventListener("resize", fit);

    let mouseX = 0.5;
    document.addEventListener("mousemove", (e) => {
      mouseX = e.clientX / window.innerWidth;
    });

    function draw(now: number) {
      if (!c || !ctx) return;
      const w = c.getBoundingClientRect().width;
      const h = c.getBoundingClientRect().height;
      ctx.clearRect(0, 0, w, h);

      const grad = ctx.createLinearGradient(0, 0, w, 0);
      grad.addColorStop(0.00, "rgba(0, 212, 255, 0)");
      grad.addColorStop(0.10, "rgba(0, 212, 255, 0.2)");
      grad.addColorStop(0.30, "rgba(0, 212, 255, 0.75)");
      grad.addColorStop(0.70, "rgba(0, 212, 255, 0.75)");
      grad.addColorStop(0.90, "rgba(0, 212, 255, 0.2)");
      grad.addColorStop(1.00, "rgba(0, 212, 255, 0)");

      const cy = h / 2;
      const amp = h * 0.32;
      const freq1 = 2 + mouseX * 2;
      const t = now * 0.001;

      ctx.strokeStyle = grad;
      ctx.lineWidth = 1.1;
      ctx.beginPath();
      for (let x = 0; x <= w; x += 2) {
        const p = x / w;
        const y = cy + Math.sin(p * Math.PI * 2 * freq1 + t) * amp
                     + Math.sin(p * Math.PI * 2 * (freq1 * 0.4) + t * 0.7) * amp * 0.25;
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.stroke();

      if (!reduce) requestAnimationFrame(draw);
    }
    if (reduce) draw(0); else requestAnimationFrame(draw);
  })();

  // ── emblem proximity + glitch (the one signature motion) ──
  (function proximity() {
    const emblem = document.getElementById("hero-emblem");
    if (!emblem) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const RADIUS = 220;
    let hot = false;
    document.addEventListener("mousemove", (e) => {
      const r = emblem.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const d = Math.hypot(e.clientX - cx, e.clientY - cy);
      const nowHot = d < RADIUS;
      if (nowHot !== hot) {
        hot = nowHot;
        emblem.classList.remove("is-hot");
        if (hot) {
          void (emblem as HTMLElement).offsetWidth;
          emblem.classList.add("is-hot");
        }
      }
    }, { passive: true });
  })();
</script>
