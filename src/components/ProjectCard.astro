---
import type { Project } from "../data/projects";

interface Props { project: Project; }
const { project } = Astro.props;
---

<a class="project" href={project.repo} target="_blank" rel="noopener">
  <div class="pin-header" aria-hidden="true"></div>
  <div class="project-head">
    <span class="designator">{project.designator}</span>
    <span class="category">{project.category}</span>
  </div>
  <span class="project-name">{project.name}</span>
  <p class="project-desc">{project.description}</p>
  <div class="project-tags">
    {project.tags.map((tag, i) => (
      <>{i > 0 && <span class="dot">·</span>}<span>{tag}</span></>
    ))}
  </div>
</a>

<style>
  .project {
    position: relative;
    display: flex; flex-direction: column;
    padding: 22px 20px 16px;
    background: #0D1019;
    border: 1px solid var(--line);
    /* square corners — this is a "component," not a rounded pill */
    border-radius: 0;
    transition: border-color 220ms ease;
  }
  .project:hover {
    border-color: var(--gold-hot);
    /* no glow, no translate, no scale — the border change is the whole hover */
  }

  /* pin header — dashed IC-package strip at top of every card */
  .pin-header {
    position: absolute;
    top: 0; left: 18px; right: 18px;
    height: 5px;
    background: repeating-linear-gradient(
      90deg,
      var(--pin-cyan) 0 3px,
      transparent 3px 13px
    );
    opacity: 0.85;
  }

  .project-head {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 10px;
  }
  .designator {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--gold);
  }
  .category {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--cyan-soft);
    text-transform: lowercase;
  }

  .project-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 15.5px;
    letter-spacing: -0.005em;
    color: var(--paper);
    transition: color 220ms ease;
  }
  .project:hover .project-name { color: var(--gold-hot); }

  .project-desc {
    color: var(--body);
    font-size: 13px;
    line-height: 1.55;
    margin-top: 6px;
    margin-bottom: 14px;
    flex: 1;
    min-height: 38px;
  }

  .project-tags {
    display: flex; gap: 6px; align-items: center;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--dust);
    letter-spacing: 0.02em;
  }
  .project-tags .dot { opacity: 0.5; }
</style>
