---
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="inner">
    <span>&copy; {year} Jordanaftermidnight</span>
    <span class="tag">jordanaftermidnight.com</span>
  </div>
</footer>

<style>
  .foot {
    margin-top: 6rem;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--line);
    position: relative;
    z-index: 2;
  }
  .inner {
    max-width: 54rem;
    margin: 0 auto;
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--dust);
  }
  .tag { color: var(--cyan); opacity: 0.6; letter-spacing: 0.08em; }
</style>
