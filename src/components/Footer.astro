---
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="inner">
    <span>
      &copy; {year} Jordanaftermidnight
      {/* After-midnight easter-egg hint. Rendered hidden; client script
          reveals it when the visitor's local hour is 0-4. */}
      <span class="late" hidden>
        · <a href="/midnight">the board is live ↗</a>
      </span>
    </span>
    <span class="tag">jordanaftermidnight.com</span>
  </div>
</footer>

<style>
  .foot {
    margin-top: 6rem;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--line);
    position: relative;
    z-index: 2;
  }
  .inner {
    max-width: 54rem;
    margin: 0 auto;
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--dust);
  }
  .tag { color: var(--cyan); opacity: 0.6; letter-spacing: 0.08em; }
  .late a {
    color: var(--dust);
    opacity: 0.45;
    text-decoration: none;
    transition: opacity 220ms ease, color 220ms ease;
  }
  .late a:hover {
    opacity: 1;
    color: var(--gold-hot);
  }
</style>

<script>
  // Reveal the /midnight hint between 00:00 and 04:59 local time.
  // Daytime visitors see nothing; night-owls get the doorway.
  const hint = document.querySelector<HTMLElement>(".foot .late");
  if (hint && new Date().getHours() < 5) hint.hidden = false;
</script>
