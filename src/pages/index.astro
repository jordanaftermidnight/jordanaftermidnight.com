---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ProjectSection from "../components/ProjectSection.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <main id="top">
    <Hero />
    <div class="stack">
      <ProjectSection
        id="software"
        title="Software"
        meta="open source · javascript / python"
        category="software"
      />
      <ProjectSection
        id="compliance"
        title="Compliance"
        meta="KYB / KYC · risk workflows"
        category="compliance"
      />
      <ProjectSection
        id="hardware"
        title="Hardware"
        meta="eurorack · arduino · docs"
        category="hardware"
      />
      <ProjectSection
        id="music"
        title="Music"
        meta="modular · signal design"
        category="music"
      />
      <ProjectSection
        id="research"
        title="Research"
        meta="ai · experimentation"
        category="research"
      />
    </div>
  </main>
  <Footer />
</Layout>

<style>
  main {
    max-width: 54rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
    position: relative;
    z-index: 2;
  }
  .stack > * + * { margin-top: 0; } /* section handles its own top spacing */
</style>
