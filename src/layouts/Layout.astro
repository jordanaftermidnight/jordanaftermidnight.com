---
import "../styles/global.css";
// CircuitBackground is now embedded inside Hero.astro (scoped to the hero
// band), not mounted globally. Sub-pages that don't want the backdrop
// simply don't include Hero.

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jordanaftermidnight — compliance expert, hacker, designer, musician",
  description = "Compliance expert by day. Hacker, designer, musician by night. Fluent in code. Not bound by it.",
} = Astro.props;

// Apex is the canonical domain. Vercel is configured to 308-redirect
// www.jordanaftermidnight.com → jordanaftermidnight.com, so this link tag
// tells search engines the definitive URL regardless of which one they
// followed to get here.
const SITE_ORIGIN = "https://jordanaftermidnight.com";
const canonical = SITE_ORIGIN + Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08080F" />

    <link rel="canonical" href={canonical} />
    {/* Favicons — modern browsers pick the SVG (sharp at any DPI), older
        browsers and RSS readers fall back to the 32x32 PNG. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE_ORIGIN + "/apple-touch-icon.png"} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
